   "source": [
    "class Staff:\n",
    "    def __init__(self, s_name, access_code):\n",
    "        self.s_name = s_name  # Public attribute\n",
    "        self.__access_code = access_code  # Private attribute\n",
    "\n",
    "    @property\n",
    "    def access_code(self):\n",
    "        \"\"\"Getter to view the access code (authorized users only logic).\"\"\"\n",
    "        # In a real scenario, add authorization checks here\n",
    "        return \"Access Granted: \" + self.__access_code\n",
    "\n",
    "    @access_code.setter\n",
    "    def access_code(self, new_code):\n",
    "        \"\"\"Setter to update the access code with validation.\"\"\"\n",
    "        if len(str(new_code)) >= 6:\n",
    "            self.__access_code = new_code\n",
    "            print(f\"Success: Access code for {self.s_name} updated.\")\n",
    "        else:\n",
    "            print(\"Error: Access code must be at least 6 characters long.\")\n",
    "\n",
    "    def display_info(self):\n",
    "        print(f\"Staff Name: {self.s_name}\")\n",
    "        # We access via the property decorator logic\n",
    "        print(f\"Access Status: {self.access_code}\")\n",
    "\n",
    "# Example Usage:\n",
    "staff1 = Staff(\"Dr. Cobbinah\", \"123456\")\n",
    "staff1.display_info()\n",
    "\n",
    "# Attempting to update\n",
    "staff1.access_code = \"987654\" # Valid\n",
    "staff1.access_code = \"123\"    # Invalid (too short)"
   ],
